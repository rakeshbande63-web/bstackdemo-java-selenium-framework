<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  Explicit test/class ordering ensures Login tests run before other tests.
  Replace the class names below with the actual fully-qualified test class names
  from your `tests` package (for example: tests.LoginTest).
-->
<suite name="bstackdemo Automation Suite" preserve-order="true">
    <!-- First run login-related tests -->
    <test name="Login Tests">
        <classes>
            <class name="tests.LoginTest"/>
            <!-- Add other login classes here if needed -->
        </classes>
    </test>

    <!-- Then run the rest of the tests in the desired order.
         Use a package scan but exclude the login class so it doesn't run twice. -->
    <test name="Other Tests">
        <packages>
            <package name="tests">
                <exclude name="tests.LoginTest"/>
            </package>
        </packages>
    </test>
</suite>
