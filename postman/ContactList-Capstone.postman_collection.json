{
  "info": {
    "name": "Contact List Capstone - API Tests",
    "_postman_id": "b6f2f1d0-0000-4c00-9c00-contactlistcapstone",
    "description": "Telecom Domain capstone: Add User -> Get profile -> Update user -> Login -> Add Contact -> Get contact list -> Get contact -> Update full contact -> Update partial contact -> Logout. Assertions use Postman's built-in chai 'pm.expect' / 'pm.test' API. Run with the collection runner or newman; requests execute top-to-bottom so variables (runEmail, token, contactId) carry across requests automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "TC_001 - Add New User",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('runEmail', 'capstone.' + Date.now() + '@fake.com');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const jsonData = pm.response.json();",
              "pm.test('Status code is 201 Created', function () {",
              "    pm.expect(pm.response.code).to.eql(201);",
              "});",
              "pm.test('Response has an auth token', function () {",
              "    pm.expect(jsonData).to.have.property('token');",
              "    pm.expect(jsonData.token).to.be.a('string').and.to.not.be.empty;",
              "});",
              "pm.test('Response user email matches the request', function () {",
              "    pm.expect(jsonData.user.email).to.eql(pm.collectionVariables.get('runEmail'));",
              "});",
              "pm.collectionVariables.set('token', jsonData.token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"Test\",\n  \"lastName\": \"User\",\n  \"email\": \"{{runEmail}}\",\n  \"password\": \"myPassword\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/users",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users"
          ]
        }
      }
    },
