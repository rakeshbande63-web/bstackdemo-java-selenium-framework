          "raw": "{\n  \"firstName\": \"Updated\",\n  \"lastName\": \"Username\",\n  \"email\": \"{{updatedEmail}}\",\n  \"password\": \"{{updatedPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/users/me",
          "host": [
